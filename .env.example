# Supabase Configuration
# Wajib diisi — Mitra CBT menyimpan semua data (siswa, soal, jadwal ujian, hasil)
# langsung di database Supabase ini, tidak ada lagi mode offline/localStorage.
# Jalankan supabase/schema.sql, seed.sql, rls_open_access.sql, dan
# seed_gto_questions.sql (sekali saja, lewat Supabase SQL Editor) sebelum
# menjalankan aplikasi untuk pertama kali.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
